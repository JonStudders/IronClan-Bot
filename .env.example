# Copy to .env and fill in. Never commit .env.

# --- Required ---
botToken=
sheetId=
discordChannelId=

# --- Discord app metadata ---
# applicationId and discordServerId are required for slash commands
# (/bingo-lead and /bingo-clear). Without them the leaderboard still runs.
applicationId=
discordServerId=
publicKey=

# Your Discord user id. Bypasses the permission checks on every command, and is
# the only account the developer DM commands obey. Leave blank to disable them.
ownerId=

# --- Per-event settings (all optional, defaults shown) ---
sheetName=Leaderboard
bingoTitle=Iron Clan Bingo
credit=BlancoIron
# Public link shown in the embed description. Omit to hide the line.
leaderboardUrl=
# Unix seconds for the bingo end time, rendered as a Discord countdown.
# Omit to hide the "Ends:" line.
bingoEndTimestamp=
thumbnailUrl=
embedColour=#6B8E23

# The top-gainers message: on | off, and how many players per category.
gainers=on
gainersRows=3

# Where the bot remembers panel state, previous ranks and lead history.
stateFile=./state.json

# --- Timing / limits (all optional, defaults shown) ---
updateIntervalMinutes=10
retryIntervalMinutes=1
maxTeams=25
