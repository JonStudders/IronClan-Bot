# Copy to .env and fill in. Never commit .env.

# --- Required ---
botToken=
sheetId=
discordChannelId=

# --- Discord app metadata ---
# applicationId and discordServerId are required for slash commands
# (/bingo-lead and /bingo-clear). Without them the leaderboard still runs.
applicationId=
discordServerId=
publicKey=

# --- Per-event settings (all optional, defaults shown) ---
sheetName=Leaderboard
bingoTitle=Iron Clan Bingo
credit=BlancoIron
# Public link shown in the embed description. Omit to hide the line.
leaderboardUrl=
# Unix seconds for the bingo end time, rendered as a Discord countdown.
# Omit to hide the "Ends:" line.
bingoEndTimestamp=
thumbnailUrl=
embedColour=#6B8E23

# Where the bot remembers the message id, previous ranks and lead history.
stateFile=./state.json

# --- Timing / limits (all optional, defaults shown) ---
updateIntervalMinutes=10
retryIntervalMinutes=1
maxTeams=25
